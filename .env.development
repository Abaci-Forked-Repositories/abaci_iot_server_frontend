DISABLE_ESLINT_PLUGIN="true"
VITE_SITE_NAME="Abaci IOT"
VITE_STORYBOOK_URL="http://localhost:6006/?path="
VITE_PRIMARY_COLOR="#22499E"
VITE_SECONDARY_COLOR="#6C757D"
# Leave empty in development so requests stay same-origin and use the Vite /api proxy
# (backend at http://111.92.105.222:58001 currently has no CORS headers).
# Set an absolute URL here only if the backend allows your frontend origin.
VITE_API_BASE_URL=
# Frontend-only mocks (MSW). true = forgot-password + settings preview; login is ALWAYS real.
# Never ship production with this true.
VITE_USE_MOCK_SERVICE=false
# TEMPORARY: skip login gate for local UI only (DEV builds). Set false to restore login.
# Never enable in production.
VITE_BYPASS_AUTH=false

