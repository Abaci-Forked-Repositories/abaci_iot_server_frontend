# Leave EMPTY when frontend is served from the same origin as the backend
# (Django serves both static files and API). Same-origin requests avoid CORS.
# Only set a full URL if frontend and backend are on DIFFERENT origins,
# AND the backend has CORS configured to allow the frontend origin.
VITE_API_BASE_URL=
VITE_USE_MOCK_SERVICE=false
